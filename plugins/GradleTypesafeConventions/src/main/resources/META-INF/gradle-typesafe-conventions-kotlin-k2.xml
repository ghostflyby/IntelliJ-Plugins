<idea-plugin>
    <depends>com.intellij.modules.kotlin.k2</depends>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <psiReferenceProvider
                implementation="dev.ghostflyby.typesafeconventions.gradle.TypesafeConventionsKotlinCatalogPsiReferenceProviderContributor"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <gotoDeclarationHandler
                implementation="dev.ghostflyby.typesafeconventions.gradle.TypesafeConventionsKotlinCatalogGotoDeclarationHandler"/>
        <referencesSearch
                implementation="dev.ghostflyby.typesafeconventions.gradle.TypesafeConventionsKotlinCatalogReferencesSearcher"/>
        <useScopeEnlarger
                implementation="dev.ghostflyby.typesafeconventions.gradle.TypesafeConventionsKotlinCatalogUseScopeEnlarger"/>
    </extensions>
</idea-plugin>

<idea-plugin>
    <id>dev.ghostflyby.mcp.workspace</id>
    <name>Workspace Agent Bridge</name>
    <vendor>ghostflyby</vendor>

    <!-- Plugin Model v2. The root descriptor only declares metadata and content modules;
         extensions live in the module descriptors next to the code that implements them.
         The backend module requires intellij.platform.backend, so the REST server loads only
         in monolith IDEs and remote-development backends; the frontend module requires
         intellij.platform.frontend, so the skill notification renders in the JetBrains Client
         of a split-mode setup. -->
    <content>
        <module name="dev.ghostflyby.mcp.workspace.shared" loading="required"/>
        <module name="dev.ghostflyby.mcp.workspace.frontend"/>
        <module name="dev.ghostflyby.mcp.workspace.backend"/>
    </content>

</idea-plugin>

<idea-plugin>
    <dependencies>
        <module name="intellij.platform.frontend"/>
        <module name="dev.ghostflyby.mcp.workspace.shared"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Workspace Agent Bridge"
                           displayType="BALLOON"
                           bundle="messages.Bundle"
                           key="sdk.notification.group.name"/>

<idea-plugin>
    <id>dev.ghostflyby.mac.recents</id>
    <name>macOS Recents</name>
    <vendor>ghostflyby</vendor>

    <depends>com.intellij.modules.platform</depends>

    <applicationListeners>
        <!--suppress PluginXmlValidity QDJVM resolves the Kotlin listener class but misses its
             RecentProjectsChange supertype; the source class implements the interface -->
        <listener class="dev.ghostflyby.mac.recents.CocoaRecentProjectsListener"
                  topic="com.intellij.ide.RecentProjectsManager$RecentProjectsChange" os="mac"/>
    </applicationListeners>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="dev.ghostflyby.mac.recents.StartUp" os="mac"/>
    </extensions>
</idea-plugin>
